# FastAPI API, Celery workers, scheduler, PostgreSQL/pgvector, and Redis.
ENVIRONMENT=production
ALLOW_DEMO_AUTH=false
JWT_ALGORITHM=HS256
JWT_ISSUER=techit-backend
JWT_AUDIENCE=techit-platform

# Must match BACKEND/backend and BACKEND/messaging-backend.
JWT_SECRET=replace-with-64-hex-character-shared-platform-secret

# Production/staging parity: the platform backend signs user access tokens with
# RS256 there (see BACKEND/backend/src/services/jwtKeyService.js), so the router
# must verify RS256 with the matching public key. To run RS256 set
# JWT_ALGORITHM=RS256 and paste the PEM public key (same value as BACKEND
# JWT_PUBLIC_KEY). HS256 + JWT_SECRET stays valid for local dev and tests.
# JWT_ALGORITHM=RS256
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_ALLOWED_ALGORITHMS=HS256,RS256

# Data stores.
POSTGRES_PASSWORD=replace-with-strong-database-password
DATABASE_URL=postgresql://techit:replace-me@postgres.example.com:5432/techit_db
REDIS_URL=rediss://redis.example.com:6379
CELERY_BROKER=rediss://redis.example.com:6379

# Browser/API boundaries. ALLOWED_ORIGINS must be the deployed SPA origin (the
# AWS value is applied separately). MCP_BASE_URL must be the https MCP mount;
# a non-https value makes /ready return 503.
ALLOWED_ORIGINS=https://beta.techitnetwork.com
MCP_BASE_URL=https://backend.techitnetwork.com/api/mcp
MCP_TIMEOUT=10

# deterministic: no provider keys required; hybrid: optional narratives; llm: provider keys required.
AI_ROUTER_MODE=hybrid

# Optional build identity for /health and /version (set by the deploy workflow).
# GIT_SHA=replace-with-commit-sha
# BUILD_TIME=replace-with-iso-timestamp

# Provider integrations are required only when AI_ROUTER_MODE=llm.
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional backend-signed execution grants. Enable after the backend issuer exists.
REQUIRE_AI_EXECUTION_GRANT=true
AI_EXECUTION_GRANT_SECRET=replace-with-a-separate-64-character-secret
AI_EXECUTION_GRANT_ISSUER=techit-backend
AI_EXECUTION_GRANT_AUDIENCE=techit-ai-router
BACKEND_USAGE_SETTLEMENT_URL=https://api.example.com/internal/usage-settlement
AI_ROUTER_SETTLEMENT_SECRET=replace-with-64-hex-character-service-secret
AI_ROUTER_SERVICE_ID=ai-router
AI_ROUTER_SETTLEMENT_TIMEOUT_SECONDS=5
AI_SETTLEMENT_OUTBOX_ENABLED=true
AI_SETTLEMENT_OUTBOX_FLUSH_SECONDS=10
# Keep false in production; apply Alembic migrations before deployment.
AI_SETTLEMENT_OUTBOX_AUTO_CREATE=false
# Token freshness (WS-05). A verified JWT is not proof that the session behind it
# still exists. Role downgrades are already re-read from the users table on every
# request; these controls close the revoked-session window.
#   0 disables the age bound. Set it above the backend access-token TTL
#   (AUTH_ACCESS_TTL_SECONDS, default 900) so normal refresh is never rejected.
AI_ROUTER_MAX_TOKEN_AGE_SECONDS=1800
# auto = enforce in staging/production, skip elsewhere; true/false force it.
AI_ROUTER_SESSION_REVOCATION_CHECK=auto
# When true, an unreachable identity store fails closed instead of logging and
# continuing. Enable only after the identity DB below is verified reachable.
AI_ROUTER_SESSION_REVOCATION_STRICT=false
# The platform identity database that owns user_sessions (techit_core). Without
# this the Router falls back to IDENTITY_DATABASE_URL, then DATABASE_URL.
AI_ROUTER_IDENTITY_DATABASE_URL=postgresql://core_app:replace@postgres.example:5432/techit_core?sslmode=require
MODEL_REGISTRY_PATH=/app/config/model_registry.json
TASK_POLICY_PATH=/app/config/task_policies.json
SCORING_POLICY_PATH=/app/config/scoring_policies.json
MODEL_REGISTRY_MAX_AGE_DAYS=30
SCORING_POLICY_MAX_AGE_DAYS=90
DECISION_AUDIT_HMAC_KEY=replace-with-64-character-decision-audit-hmac-key

# Optional provider/storage/observability integrations.
COHERE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
MISTRAL_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=techit-embeddings
ELEVENLABS_API_KEY=
AWS_S3_BUCKET=techit-dev-uploads
AWS_ACCESS_KEY_ID=replace-with-private-object-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-private-object-storage-secret
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256
MAX_UPLOAD_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=900
SENTRY_DSN=

# WS-14: ai-router request ceiling per credential per minute. 0 disables it.
AI_ROUTER_RATE_LIMIT_PER_MINUTE=120
